{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run lint:fix)",
      "Bash(pnpm run format)",
      "Bash(pnpm run changeset)",
      "Bash(pnpm exec:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(gh pr:*)",
      "Bash(gh pr create:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote add:*)",
      "Bash(git push upstream:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*wallet_secret*)",
      "Read(./**/cdp_api_key*)",
      "Read(./**/cdp_wallet_secret*)",
      "Read(./**/wallet_data*)"
    ]
  }
}
